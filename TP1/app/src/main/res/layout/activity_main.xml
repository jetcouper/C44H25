<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity" >

    <LinearLayout
        android:id="@+id/linearCouleur"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/material_dynamic_tertiary40"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBrun"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="1dp"
            android:layout_weight="1"
            android:backgroundTint="@color/brun"
            app:strokeWidth="2dp" />

        <Button
            android:id="@+id/btnJaune"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="1dp"
            android:layout_weight="1"
            android:backgroundTint="@color/jaune"
            app:strokeWidth="2dp" />

        <Button
            android:id="@+id/btnBlanc"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="1dp"
            android:layout_weight="1"
            android:backgroundTint="@color/white"
            app:strokeWidth="2dp" />

        <Button
            android:id="@+id/btnNoir"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="1dp"
            android:layout_weight="1"
            android:backgroundTint="@color/black"
            app:strokeWidth="2dp" />

        <Button
            android:id="@+id/btnPink"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="1dp"
            android:layout_weight="1"
            android:backgroundTint="@color/rose"
            app:strokeWidth="2dp" />

        <Button
            android:id="@+id/btnRouge"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="1dp"
            android:layout_weight="1"
            android:backgroundTint="@color/rouge"
            app:strokeWidth="2dp" />

        <Button
            android:id="@+id/btnBleu"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="1dp"
            android:layout_weight="1"
            android:backgroundTint="@color/bleu"
            app:strokeWidth="2dp" />

        <Button
            android:id="@+id/btnVert"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="1dp"
            android:layout_weight="1"
            android:backgroundTint="@color/vert"
            app:strokeWidth="2dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:orientation="horizontal"></LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/material_dynamic_tertiary40"
        android:orientation="horizontal">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingLeft="20px"
                    app:srcCompat="@drawable/crayon" />

                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingLeft="20px"
                    app:srcCompat="@drawable/efface" />

                <ImageView
                    android:id="@+id/imageView3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingLeft="20px"
                    app:srcCompat="@drawable/cercle" />

                <ImageView
                    android:id="@+id/imageView4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingLeft="20px"
                    app:srcCompat="@drawable/triangle" />

                <ImageView
                    android:id="@+id/imageView5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingLeft="20px"
                    app:srcCompat="@drawable/largeur_trait" />

                <ImageView
                    android:id="@+id/imageView7"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingLeft="20px"
                    app:srcCompat="@drawable/rectangle" />

                <ImageView
                    android:id="@+id/imageView9"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingLeft="20px"
                    app:srcCompat="@drawable/pipette" />

                <ImageView
                    android:id="@+id/imageView10"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingLeft="20px"
                    app:srcCompat="@drawable/remplir" />

                <ImageView
                    android:id="@+id/imageView11"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingLeft="20px"
                    app:srcCompat="@drawable/redo" />

                <ImageView
                    android:id="@+id/imageView12"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingLeft="20px"
                    app:srcCompat="@drawable/undo" />

                <ImageView
                    android:id="@+id/imageView13"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingLeft="20px"
                    app:srcCompat="@drawable/enregistrer" />
            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>
</LinearLayout>