<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true" >
        <shape android:shape="rectangle"  >
            <corners android:radius="12dip" />
            <stroke android:width="12px" android:color="@color/teal_200" />
            <gradient android:angle="90" android:endColor="@color/rouge" android:startColor="@color/jaune" android:type="linear">

            </gradient>
        </shape>
    </item>
    <item >
        <shape android:shape="rectangle"  >
            <corners android:radius="12dp" />
            <stroke android:width="12dp" android:color="#ff0000" />
            <gradient android:angle="270" android:endColor="@color/rouge" android:startColor="@color/jaune" android:type="linear">

            </gradient>
        </shape>
    </item>

</selector>