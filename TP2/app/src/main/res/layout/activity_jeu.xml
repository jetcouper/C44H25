<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#5A1D1D"
    android:orientation="vertical"
    tools:context=".Jeu_Activity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5"
        android:background="#1C1C1C"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="CARTES"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/textView5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="TEMPS"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/textView6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="SCORE"
                android:textColor="@color/white"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtNbCarte"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <Chronometer
                android:id="@+id/chronometerTemps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/txtScoreActuel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="20sp" />


        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="right"
        android:layout_weight="1"
        android:background="#5A1D1D"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnRetourMenu"
            android:layout_width="250px"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:text="Menu" />

        <Button
            android:id="@+id/btnReverse"
            android:layout_width="250px"
            android:layout_height="125px"
            android:layout_marginLeft="10px"
            android:background="@drawable/bg_card"
            android:drawableLeft="@android:drawable/ic_menu_revert"
            android:scaleType="centerInside"
            />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#5A1D1D"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="325px"
                android:layout_height="325px"
                android:background="@drawable/bg_layout"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgGaucheHaut"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:srcCompat="@drawable/black_arrow_pointing_up_svgrepo_com" />

                <LinearLayout
                    android:id="@+id/lCarte1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="8dp"
                    android:layout_weight="1.5"
                    android:background="@drawable/bg_card"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtCarte1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="0"
                        android:textSize="50px" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="325px"
                android:layout_height="325px"
                android:background="@drawable/bg_layout"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/lCarte2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="8dp"
                    android:layout_weight="1.5"
                    android:background="@drawable/bg_card"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtCarte2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="0"
                        android:textSize="50px" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgDroitHaut"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:srcCompat="@drawable/black_arrow_pointing_up_svgrepo_com" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#5A1D1D"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="325px"
                android:layout_height="325px"
                android:background="@drawable/bg_layout"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgGaucheBas"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:scaleY="-1"
                    app:srcCompat="@drawable/black_arrow_pointing_up_svgrepo_com" />

                <LinearLayout
                    android:id="@+id/lCarte3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="8dp"
                    android:layout_weight="1.5"
                    android:background="@drawable/bg_card"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtCarte3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="98"
                        android:textSize="50px" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="325px"
                android:layout_height="325px"
                android:background="@drawable/bg_layout"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/lCarte4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="8dp"
                    android:layout_weight="1.5"
                    android:background="@drawable/bg_card"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtCarte4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="98"
                        android:textSize="50px" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgDroitBas"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:scaleY="-1"
                    app:srcCompat="@drawable/black_arrow_pointing_up_svgrepo_com" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/Linear1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="118px"
        android:layout_marginRight="118px"
        android:layout_weight="1"
        android:background="#5A1D1D"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/la1"
            android:layout_width="0dp"
            android:layout_height="280px"
            android:layout_margin="8dp"
            android:layout_weight="1.5"
            android:background="@drawable/bg_card"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txt1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="50px" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/la2"
            android:layout_width="0dp"
            android:layout_height="280px"
            android:layout_margin="8dp"
            android:layout_weight="1.5"
            android:background="@drawable/bg_card"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txt2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="50px" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/la3"
            android:layout_width="0dp"
            android:layout_height="280px"
            android:layout_margin="8dp"
            android:layout_weight="1.5"
            android:background="@drawable/bg_card"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txt3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="50px" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/la4"
            android:layout_width="0dp"
            android:layout_height="280px"
            android:layout_margin="8dp"
            android:layout_weight="1.5"
            android:background="@drawable/bg_card"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txt4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="50px" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/Linear2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="118px"
        android:layout_marginRight="118px"
        android:layout_marginBottom="30px"
        android:layout_weight="1"
        android:background="#5A1D1D"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/la5"
            android:layout_width="0dp"
            android:layout_height="280px"
            android:layout_margin="8dp"
            android:layout_weight="1.5"
            android:background="@drawable/bg_card"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txt5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="50px" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/la6"
            android:layout_width="0dp"
            android:layout_height="280px"
            android:layout_margin="8dp"
            android:layout_weight="1.5"
            android:background="@drawable/bg_card"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txt6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="50px" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/la7"
            android:layout_width="0dp"
            android:layout_height="280px"
            android:layout_margin="8dp"
            android:layout_weight="1.5"
            android:background="@drawable/bg_card"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txt7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="50px" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/la8"
            android:layout_width="0dp"
            android:layout_height="280px"
            android:layout_margin="8dp"
            android:layout_weight="1.5"
            android:background="@drawable/bg_card"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txt8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="50px" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>